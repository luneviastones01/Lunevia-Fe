{
  "buildCommand": "npm install --legacy-peer-deps && npm run build:client",
  "outputDirectory": "dist/client",
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "X-Robots-Tag", "value": "all" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/:match*", "destination": "https://lunevia-be.vercel.app/api/:match*" },
    { "source": "/uploads/:match*", "destination": "https://lunevia-be.vercel.app/uploads/:match*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
